{
  "name": "@karaoke/desktop",
  "version": "0.1.0",
  "description": "Consola del operador y proyección local de Karaoke Total",
  "author": "Karaoke Total Team",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:main": "node bundle-main.cjs",
    "build": "pnpm run build:vite && pnpm run build:main",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "electron ./dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@karaoke/contracts": "workspace:*",
    "@karaoke/database": "workspace:*",
    "@karaoke/media-indexer": "workspace:*",
    "@karaoke/media-engine": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "zod": "^3.24.1"
  }
}
