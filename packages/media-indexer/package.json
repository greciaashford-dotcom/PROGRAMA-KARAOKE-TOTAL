  },
  "dependencies": {
    "@karaoke/contracts": "workspace:*",
    "chokidar": "^4.0.3",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
